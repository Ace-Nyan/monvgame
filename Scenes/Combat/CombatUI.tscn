layout_mode = 2
text = "回合 0"
theme_override_font_sizes/font_size = 24

[node name="Spacer" type="Control" parent="Root/VBox/TopBar"]
layout_mode = 2
size_flags_horizontal = 3

[node name="ResultLabel" type="Label" parent="Root/VBox/TopBar"]
