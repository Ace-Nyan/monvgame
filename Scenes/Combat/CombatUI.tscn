[ext_resource type="Script" path="res://Scripts/UI/CombatUI.gd" id="1"]

[node name="CombatUI" type="CanvasLayer"]
script = ExtResource("1")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Bg" type="ColorRect" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.55)
mouse_filter = 2

[node name="VBox" type="VBoxContainer" parent="Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 8

; === 顶部状态条 ===
[node name="TopBar" type="HBoxContainer" parent="Root/VBox"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="TurnLabel" type="Label" parent="Root/VBox/TopBar"]
